# ============================================================
# LACS API Server 环境变量模板
# 复制本文件为 .env.local 并填入真实值：cp .env.example .env.local
# 警告：切勿将 .env.local 提交到版本控制，切勿把密钥写成 NEXT_PUBLIC_* 前缀
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:29351/app

# ---------- Supabase（数据库 + 认证）----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your-supabase-publishable-key
# 服务端专用，拥有最高权限，绝不可加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://user:password@host:5432/database
SYSTEM_SETTINGS_DATABASE_URL=postgresql://user:password@host:5432/database

# ---------- API 鉴权（服务端密钥，不要暴露到前端）----------
API_KEY=your-server-api-key
API_KEY_EXPIRATION_HOURS=24
ENABLE_API_KEY_AUTH=true
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION_HOURS=24
# 已废弃：前端已改用 Supabase 会话鉴权，请勿再配置此项
# NEXT_PUBLIC_API_KEY=（不要设置）

# ---------- 管理员白名单 ----------
ALLOWED_ADMIN_EMAILS=admin@example.com

# ---------- 安全策略 ----------
ENABLE_RATE_LIMITING=true
ENABLE_REQUEST_SIGNATURE=false
REQUEST_SIGNATURE_SECRET=your-request-signature-secret
ENABLE_STRICT_USER_AGENT_CHECK=false
ENABLE_USER_BEHAVIOR_API_SECURITY=true
ALLOWED_CLIENT_ORIGINS=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com
ALLOWED_USER_AGENTS=

# ---------- 用户行为 API 专用密钥 ----------
USER_BEHAVIOR_API_KEY=your-user-behavior-api-key
USER_BEHAVIOR_RECORD_API_KEY=your-user-behavior-record-api-key

# ---------- 邮件通知（Resend）----------
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=noreply@your-domain.com

# ---------- 第三方集成 ----------
IMGBED_TOKEN=your-imgbed-token
WANJIGUANJIA_APP_ID=your-app-id
WANJIGUANJIA_APP_SECRET=your-app-secret
